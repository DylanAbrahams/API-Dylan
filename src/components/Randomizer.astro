---
const { pokemonList } = Astro.props;

---

<div class="random-container">
  <div class="controls">
    <label for="game-slider">Pokémon kracht / spelprogressie:</label>
    <input type="range" id="game-slider" min="0" max="150" value="50">
    <span id="slider-value">50</span>

    <select id="type-filter">
      <option value="">All types</option>
      <option value="fire">Fire</option>
      <option value="water">Water</option>
      <option value="grass">Grass</option>
      <option value="electric">Electric</option>
      <option value="psychic">Psychic</option>
      <option value="ice">Ice</option>
      <option value="dark">Dark</option>
      <option value="fairy">Fairy</option>
      <option value="normal">Normal</option>
      <option value="fighting">Fighting</option>
      <option value="ground">Ground</option>
      <option value="flying">Flying</option>
      <option value="poison">Poison</option>
      <option value="bug">Bug</option>
      <option value="rock">Rock</option>
      <option value="ghost">Ghost</option>
      <option value="dragon">Dragon</option>
      <option value="steel">Steel</option>
    </select>

    <button id="random-btn">Randomize Pokémon</button>
  </div>

  <div id="pokemon-display"></div>
  <div id="pokemon-data" data-list={JSON.stringify(pokemonList)}></div>
</div>

<script type="module">
import {
  loadPokemon,
  savePokemon,
  addPokemon,
  removePokemon
} from "/src/game/pokemonStorage.js";

document.addEventListener("DOMContentLoaded", () => {
  const display = document.getElementById("pokemon-display");
  const btn = document.getElementById("random-btn");
  const filterSelect = document.getElementById("type-filter");
  const slider = document.getElementById("game-slider");
  const sliderValue = document.getElementById("slider-value");
  const dataDiv = document.getElementById("pokemon-data");

  let enrichedList = [];

  // -------------------------
  slider.oninput = () => sliderValue.textContent = slider.value;

  async function fetchJSON(url, fallback = null) {
    try {
      const res = await fetch(url);
      return await res.json();
    } catch {
      return fallback;
    }
  }

  const shuffle = arr => arr.slice().sort(() => Math.random() - 0.5);

  // -------------------------
  async function enrich(list) {
    return await Promise.all(list.map(async p => {
      const d = await fetchJSON(p.url, {});
      return {
        ...p,
        types: d.types?.map(t => t.type.name) || [],
        stats: d.stats || [],
        moves: d.moves || [],
        artwork: d.sprites?.other?.["official-artwork"]?.front_default || '',
        frontSprite: d.sprites?.front_default || '',
        id: d.id || 0
      };
    }));
  }

  async function getMove(move) {
    const d = await fetchJSON(move.move.url);
    return {
      name: move.move.name,
      type: d?.type?.name || 'unknown',
      damage_class: d?.damage_class?.name || 'unknown'
    };
  }

  async function getCatchRate(p) {
    const d = await fetchJSON(`https://pokeapi.co/api/v2/pokemon-species/${p.id}`);
    return d?.capture_rate || 45;
  }

  const tryCatch = rate => Math.random() < (rate / 255);

  // -------------------------
  function renderMoves(moves) {
    return `
      <h3>Moves</h3>
      <ul class="moves-list">
        ${moves.map(m => `
          <li>
            ${m.name}
            <span class="move-type type-${m.type}">${m.type}</span>
            <span class="move-category">${m.damage_class}</span>
          </li>
        `).join('')}
      </ul>
    `;
  }

  async function showPokemon(p) {
    let moves = shuffle(p.moves).slice(0, 4);
    moves = await Promise.all(moves.map(getMove));

    display.innerHTML = `
      <div class="wild-pokemon">
        <h2>${p.name}</h2>
        <img src="${p.artwork}" alt="${p.name}">
        ${renderMoves(moves)}
        <button id="catch-btn">Catch</button>
        <p id="catch-result"></p>
      </div>
    `;
  }

  // -------------------------
  function weightedRandom(list, target) {
    const k = 0.08;

    const weights = list.map(p => {
      const avg = p.stats.reduce((s, x) => s + x.base_stat, 0) / p.stats.length;
      return Math.exp(-k * Math.abs(avg - target));
    });

    let rnd = Math.random() * weights.reduce((a, b) => a + b, 0);

    for (let i = 0; i < list.length; i++) {
      if ((rnd -= weights[i]) < 0) return list[i];
    }

    return list[0];
  }

  // -------------------------
  const baseList = JSON.parse(dataDiv.dataset.list);

  enrich(baseList).then(list => enrichedList = list);

  // -------------------------
  // RANDOM BUTTON
  // -------------------------
  btn.addEventListener("click", async () => {
    if (!enrichedList.length) return;

    const type = filterSelect.value;
    const target = parseInt(slider.value, 10);

    let list = enrichedList;

    if (type) list = list.filter(p => p.types.includes(type));

    if (!list.length) {
      display.innerHTML = "<p>Geen Pokémon gevonden.</p>";
      return;
    }

    const chosen = weightedRandom(list, target);
    await showPokemon(chosen);
  });

  // -------------------------
  // CATCH SYSTEM
  // -------------------------
  document.addEventListener("click", async e => {
    if (e.target.id !== "catch-btn") return;

    const name = display.querySelector("h2").textContent;
    const p = enrichedList.find(p => p.name === name);
    if (!p) return;

    const success = tryCatch(await getCatchRate(p));
    const result = document.getElementById("catch-result");

    if (!success) {
      result.textContent = `${p.name} ontsnapt!`;
      result.style.color = "red";
      return;
    }

    result.textContent = `${p.name} gevangen!`;
    result.style.color = "green";

    addPokemon({
      name: p.name,
      frontSprite: p.frontSprite
    });

    // 🔥 trigger update event
    window.dispatchEvent(new Event("pokemon-updated"));

    display.innerHTML = "";
  });

});
</script>