<div class="game-wrapper">
  <canvas id="main-canvas" width=900 height=500></canvas>

  <div class="mobile-controls">
  <button data-key="ArrowUp">▲</button>

  <div class="row">
    <button data-key="ArrowLeft">◀</button>
    <button data-key="ArrowDown">▼</button>
    <button data-key="ArrowRight">▶</button>
  </div>
</div>
</div>

<style>
  .game-wrapper {
    width: 100vw;
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background: #000000;
  }

  canvas {
    border: 4px solid #000000;
    background: #000000;
  }

  .mobile-controls {
  position: fixed;
  bottom: 20px;
  left: 50%;
  transform: translateX(-50%);
  display: none;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  z-index: 10;
}

.mobile-controls .row {
  display: flex;
  gap: 10px;
}

.mobile-controls button {
  width: 60px;
  height: 60px;
  font-size: 20px;
  border-radius: 12px;
  border: none;
  background: rgba(255,255,255,0.2);
  color: white;
  backdrop-filter: blur(5px);
}

@media (max-width: 768px) {
  .mobile-controls {
    display: flex;
  }
}
</style>

<script type="module">
  import { walls } from "../game/walls.js";
  import { grass } from "../game/grass.js";
  import { addPokemon, loadPokemon } from "../game/pokemonStorage.js";

  /* -------------------- CONFIG -------------------- */
  const ENCOUNTER_CHANCE = 0.2;
  const ENCOUNTER_CHECK_RATE = 0.25;

  /* -------------------- CANVAS -------------------- */
  const canvas = document.getElementById("main-canvas");
  const ctx = canvas.getContext("2d");
  ctx.imageSmoothingEnabled = false;

  let scale = 1;
  let offsetX = 0;
  let offsetY = 0;

  function resizeCanvas() {
    const baseW = canvas.width;
    const baseH = canvas.height;

    const screenW = window.innerWidth;
    const screenH = window.innerHeight;

    scale = Math.min(screenW / baseW, screenH / baseH);

    offsetX = (screenW - baseW * scale) / 2;
    offsetY = (screenH - baseH * scale) / 2;

    canvas.style.width = baseW * scale + "px";
    canvas.style.height = baseH * scale + "px";
  }

  window.addEventListener("resize", resizeCanvas);
  resizeCanvas();
  /* -------------------- IMAGES -------------------- */
  const img = new Image();
  img.src = "/assets/Route1-Tilemap.png";

  const battleBg = new Image();
  battleBg.src = "/assets/battle-bg.png";

  const playerImg = new Image();
  playerImg.src = "/assets/Trainer_Spritesheet.png";

  const pokeballImg = new Image();
  pokeballImg.src = "/assets/pokeball.png";

  const viewW = canvas.width;
  const viewH = canvas.height;

  /* ================= AUDIO ================= */
  // SFX
  const sounds = {
    button: new Audio("/assets/audio/sfx_button.m4a"),

    throw: new Audio("/assets/audio/sfx_throw.wav"),
    shake: new Audio("/assets/audio/sfx_shake.wav"),
    breakfree: new Audio("/assets/audio/sfx_brokefree.wav"),
    caught: new Audio("/assets/audio/sfx_caught.wav"),
    run: new Audio("/assets/audio/sfx_run.wav"),
  };

  Object.values(sounds).forEach((s) => {
    s.volume = 0.6;
    s.load();
  });

  function playSound(sound) {
    const s = sound.cloneNode();
    s.volume = sound.volume;
    s.play();
  }

  // Muziek

  const worldMusic = new Audio("/assets/audio/route.mp3");
  const battleMusic = new Audio("/assets/audio/battle.mp3");

  worldMusic.loop = true;
  battleMusic.loop = true;

  worldMusic.volume = 0.2;
  battleMusic.volume = 0.2;

  let musicStarted = false;

  /* -------------------- STATE -------------------- */
  let lastTime = 0;
  let gameState = "world"; // "world" | "encounter"
  let currentPokemon = null;
  let enrichedList = [];
  let battleSprite = new Image();
  let backSprite = new Image();
  let battleMessage = "";
  let messageQueue = [];
  let messageTimer = 0;
  let uiMode = "menu"; // "menu" | "message"

  let catchAnimation = {
    active: false,
    phase: "idle",
    timer: 0,
    shakes: 0,
    success: false,
    caughtSoundPlayed: false,
  };

  // Omdat je niet automatisch muziek kan afspelen, begint de muziek pas bij een klik
  window.addEventListener("click", () => {
    if (!musicStarted) {
      worldMusic.play();
      musicStarted = true;
    }
  });

  /* -------------------- UI -------------------- */
  let partyOpen = false;
  const spriteCache = {};

  /* -------------------- PLAYER -------------------- */
  const saved = JSON.parse(localStorage.getItem("playerState"));

  const player = {
    x: saved?.x ?? 970,
    y: saved?.y ?? 1060,
    size: 36,
    speed: 240,
    frame: 0,
    direction: saved?.direction ?? 0,
    moving: false,
  };

  const keys = {};
  window.addEventListener("keydown", (e) => (keys[e.key] = true));
  window.addEventListener("keyup", (e) => (keys[e.key] = false));

  function savePlayer() {
    localStorage.setItem(
      "playerState",
      JSON.stringify({
        x: player.x,
        y: player.y,
        direction: player.direction,
      }),
    );
  }

  /* -------------------- API -------------------- */
  async function fetchJSON(url) {
    try {
      const res = await fetch(url);
      return await res.json();
    } catch {
      return null;
    }
  }

  async function enrich(list) {
    return await Promise.all(
      list.map(async (p) => {
        const d = await fetchJSON(p.url);

        return {
          ...p,
          id: d?.id,
          stats: d?.stats || [],
          types: d?.types?.map((t) => t.type.name) || [],
          frontSprite: d?.sprites?.front_default || "",
          backSprite: d?.sprites?.back_default || "",
          cries: d?.cries || null,
        };
      }),
    );
  }

  async function loadPokedex() {
    const res = await fetch("https://pokeapi.co/api/v2/pokemon?limit=151");
    const data = await res.json();
    enrichedList = await enrich(data.results);
  }

  loadPokedex();

  /* -------------------- TEAM -------------------- */
  function getPlayerPokemon() {
    const team = loadPokemon();
    if (!team.length) return null;
    return team[0];
  }

  /* -------------------- ENCOUNTER -------------------- */
  function startEncounter(zone) {
    if (!enrichedList.length) return;

    gameState = "encounter";

    worldMusic.pause();
    battleMusic.currentTime = 0;
    battleMusic.play();

    let pool = enrichedList;

    if (zone?.types?.length) {
      pool = enrichedList.filter((p) =>
        p.types.some((t) => zone.types.includes(t)),
      );
    }

    if (pool.length === 0) {
      pool = enrichedList;
    }

    currentPokemon = pool[Math.floor(Math.random() * pool.length)];

    battleSprite = new Image();
    battleSprite.src = currentPokemon.frontSprite;

    const playerMon = getPlayerPokemon();

    backSprite = new Image();
    backSprite.src = playerMon?.backSprite || playerMon?.frontSprite || "";

    // CRY GELUID
    const cryUrl =
      currentPokemon?.cries?.latest || currentPokemon?.cries?.legacy;

    setTimeout(() => {
      const cry = new Audio(cryUrl);
      cry.volume = 0.2;
      cry.play();
    }, 1000);
  }

  function endEncounter() {
    gameState = "world";

    battleMusic.pause();
    worldMusic.play();
    catchAnimation.caughtSoundPlayed = false;

    uiMode = "menu";
    battleMessage = "";
    messageQueue = [];
    currentPokemon = null;
  }

  /* -------------------- COLLISION -------------------- */
  function isColliding(x, y) {
    const half = player.size / 2;

    return walls.some(
      (w) =>
        x + half > w.x &&
        x - half < w.x + w.w &&
        y + half > w.y &&
        y - half < w.y + w.h,
    );
  }

  function getGrassZone(x, y) {
    const half = player.size / 2;

    return grass.find(
      (g) =>
        x + half > g.x &&
        x - half < g.x + g.w &&
        y + half > g.y &&
        y - half < g.y + g.h,
    );
  }

  /* -------------------- CATCH -------------------- */
  let encounterCooldown = 0;

  function updateCatchAnimation(dt) {
    catchAnimation.timer += dt;

    /* -------------------- SHRINK -------------------- */
    if (catchAnimation.phase === "shrink") {
      if (catchAnimation.timer > 0.5) {
        catchAnimation.phase = "shake";
        catchAnimation.timer = 0;
      }
    }

    /* -------------------- SHAKE -------------------- */
    if (catchAnimation.phase === "shake") {
      const SHAKE_DURATION = 1.0;
      const MAX_SHAKES = 3;

      const shakeIndex = Math.floor(catchAnimation.timer / SHAKE_DURATION);

      if (catchAnimation.lastShakeIndex === undefined) {
        catchAnimation.lastShakeIndex = -1;
      }

      if (shakeIndex !== catchAnimation.lastShakeIndex) {
        catchAnimation.lastShakeIndex = shakeIndex;

        if (shakeIndex < MAX_SHAKES) {
          playSound(sounds.shake);
        }
      }

      if (shakeIndex >= MAX_SHAKES) {
        catchAnimation.phase = "done";
        catchAnimation.timer = 0;

        if (catchAnimation.success && !catchAnimation.caughtSoundPlayed) {
          playSound(sounds.caught);
          catchAnimation.caughtSoundPlayed = true;
        }
      }
    }

    /* -------------------- DONE -------------------- */
    if (catchAnimation.phase === "done") {
      if (catchAnimation.timer > 0.6) {
        if (catchAnimation.success) {
          if (catchAnimation.successHandled) return;
          catchAnimation.successHandled = true;

          addPokemon({
            name: currentPokemon.name,
            frontSprite: currentPokemon.frontSprite,
            backSprite: currentPokemon.backSprite,
            cries: currentPokemon.cries,
          });

          window.dispatchEvent(new Event("pokemon-updated"));

          showMessage(`POKÉMON WAS CAUGHT!`);
          showMessage("It was added to your party!");

          setTimeout(() => {
            catchAnimation.active = false;
            endEncounter();
          }, 1200);
        } else {
          playSound(sounds.breakfree);

          // Pokémon cry bij ontsnappen
          const cryUrl =
            currentPokemon?.cries?.latest || currentPokemon?.cries?.legacy;

          if (cryUrl) {
            setTimeout(() => {
              const cry = new Audio(cryUrl);
              cry.volume = 0.2;
              cry.play().catch(() => {});
            }, 200);
          }

          showMessage("Oh no! It broke free!");
          uiMode = "message";

          catchAnimation.phase = "idle";
          catchAnimation.timer = 0;
          catchAnimation.shakes = 0;

          catchAnimation.active = false;
        }
      }
    }
  }

  /* ================= UPDATE =========================== */

  function update(dt) {
    /* -------------------- CATCH STATE -------------------- */
    if (catchAnimation.active) {
      updateCatchAnimation(dt);
      return;
    }

    /* -------------------- WORLD ONLY -------------------- */
    if (gameState !== "world") return;

    /* -------------------- INPUT -------------------- */
    let nextX = player.x;
    let nextY = player.y;

    player.moving = false;

    const speed = player.speed * dt;

    let dx = 0;
    let dy = 0;

    if (keys["ArrowDown"] || keys["s"]) {
      dy++;
      player.direction = 0;
    }
    if (keys["ArrowUp"] || keys["w"]) {
      dy--;
      player.direction = 3;
    }
    if (keys["ArrowLeft"] || keys["a"]) {
      dx--;
      player.direction = 1;
    }
    if (keys["ArrowRight"] || keys["d"]) {
      dx++;
      player.direction = 2;
    }

    player.moving = dx !== 0 || dy !== 0;

        /* -------------------- MOBILE -------------------- */

    const mobileButtons = document.querySelectorAll(".mobile-controls button");

    mobileButtons.forEach((btn) => {
      const key = btn.dataset.key;

      btn.addEventListener("touchstart", (e) => {
        e.preventDefault();
        keys[key] = true;
      });

      btn.addEventListener("touchend", (e) => {
        e.preventDefault();
        keys[key] = false;
      });

      // extra support voor muis (debug)
      btn.addEventListener("mousedown", () => (keys[key] = true));
      btn.addEventListener("mouseup", () => (keys[key] = false));
      btn.addEventListener("mouseleave", () => (keys[key] = false));
    });

    /* -------------------- MOVEMENT -------------------- */
    if (player.moving) {
      const len = Math.hypot(dx, dy);
      dx /= len;
      dy /= len;

      nextX += dx * speed;
      nextY += dy * speed;
    }

    /* -------------------- COLLISION -------------------- */
    if (!isColliding(nextX, player.y)) player.x = nextX;
    if (!isColliding(player.x, nextY)) player.y = nextY;

    /* -------------------- WORLD BOUNDS -------------------- */
    const half = player.size / 2;

    player.x = Math.max(half, Math.min(player.x, img.width - half));
    player.y = Math.max(half, Math.min(player.y, img.height - half));

    savePlayer();

    /* -------------------- GRASS ENCOUNTER -------------------- */
    const zone = getGrassZone(player.x, player.y);

    if (player.moving && zone) {
      encounterCooldown += dt;

      if (encounterCooldown > ENCOUNTER_CHECK_RATE) {
        encounterCooldown = 0;

        if (Math.random() < ENCOUNTER_CHANCE) {
          startEncounter(zone);
        }
      }
    } else {
      encounterCooldown = 0;
    }

    /* -------------------- MESSAGE TIMER -------------------- */
    if (messageTimer > 0) {
      messageTimer -= dt;

      if (messageTimer <= 0) {
        battleMessage = "";
      }
    }
  }

  /* -------------------- LOOP ANIMATIE -------------------- */
  let frameTimer = 0;

  function updateAnimation(dt) {
    if (player.moving) {
      frameTimer += dt;
      if (frameTimer > 0.1) {
        player.frame = (player.frame + 1) % 4;
        frameTimer = 0;
      }
    } else {
      player.frame = 0;
    }
  }

  /* -------------------- ALLE DRAW FUNCTIES -------------------- */
  function draw() {
    ctx.clearRect(0, 0, viewW, viewH);

    drawWorld();
    drawEncounter();
    drawParty();
  }

  /* -------------------- WORLD -------------------- */
  function drawWorld() {
    if (gameState !== "world") return;

    const cam = getCamera();

    ctx.drawImage(img, cam.x, cam.y, viewW, viewH, 0, 0, viewW, viewH);

    const sx = player.x - cam.x;
    const sy = player.y - cam.y;

    ctx.drawImage(
      playerImg,
      player.frame * 64,
      player.direction * 64,
      64,
      64,
      sx - 32,
      sy - 32,
      64,
      64,
    );
  }

  function getCamera() {
    let x = player.x - viewW / 2;
    let y = player.y - viewH / 2;

    x = Math.max(0, Math.min(x, img.width - viewW));
    y = Math.max(0, Math.min(y, img.height - viewH));

    return { x, y };
  }

  /* -------------------- PARTY -------------------- */
  function drawParty() {
    if (!partyOpen) return;

    const team = loadPokemon();

    ctx.fillStyle = "rgba(0,0,0,0.75)";
    ctx.fillRect(0, 0, viewW, viewH);

    ctx.fillStyle = "#fff";
    ctx.textAlign = "center";
    ctx.font = "bold 22px Arial";
    ctx.fillText("Select Pokémon", viewW / 2, 80);

    const boxSize = 90;
    const startX = (viewW - team.length * (boxSize + 10)) / 2;
    const startY = viewH / 2 - 40;

    for (let i = 0; i < team.length; i++) {
      const mon = team[i];
      const x0 = startX + i * (boxSize + 10);

      ctx.fillStyle = "#222";
      ctx.fillRect(x0, startY, boxSize, boxSize);

      ctx.strokeStyle = "#fff";
      ctx.strokeRect(x0, startY, boxSize, boxSize);

      if (mon.frontSprite) {
        if (!spriteCache[mon.frontSprite]) {
          spriteCache[mon.frontSprite] = new Image();
          spriteCache[mon.frontSprite].src = mon.frontSprite;
        }

        const img = spriteCache[mon.frontSprite];

        if (img.complete) {
          ctx.drawImage(img, x0 + 13, startY + 13, 64, 64);
        }
      }

      ctx.fillStyle = "#fff";
      ctx.font = "12px Arial";
      ctx.fillText(
        mon.name.toUpperCase(),
        x0 + boxSize / 2,
        startY + boxSize + 15,
      );
    }
  }

  /* -------------------- ENCOUNTER -------------------- */
  function drawEncounter() {
    if (gameState !== "encounter" || !currentPokemon) return;

    ctx.drawImage(battleBg, 0, 0, viewW, viewH);

    drawBattleUI();
    drawSprites();
    drawButtons();
    drawPokeball();
    drawMessageBox();
  }

  /* -------------------- ALLE ENCOUNTER SUBFUNCTIES -------------------- */

  function drawBattleUI() {
    const name = currentPokemon.name.toUpperCase();

    const x = 20;
    const y = 20;
    const w = 260;
    const h = 50;

    // outer border (zwart)
    ctx.fillStyle = "#000";
    ctx.fillRect(x - 2, y - 2, w + 4, h + 4);

    // inner background
    ctx.fillStyle = "#f8f8f8";
    ctx.fillRect(x, y, w, h);

    // inner border
    ctx.strokeStyle = "#444";
    ctx.strokeRect(x, y, w, h);

    // tekst
    ctx.fillStyle = "#000";
    ctx.font = "bold 20px Arial";
    ctx.textAlign = "left";
    ctx.textBaseline = "middle";

    ctx.fillText(name, x + 16, y + h / 2);

    // reset
    ctx.textAlign = "left";
    ctx.textBaseline = "alphabetic";
  }

  function drawSprites() {
    if (!catchAnimation.active && battleSprite.complete) {
      const scale = 3;
      const w = battleSprite.naturalWidth * scale;
      const h = battleSprite.naturalHeight * scale;

      ctx.drawImage(battleSprite, viewW * 0.72 - w / 2, viewH * 0.75 - h, w, h);
    }

    if (backSprite.complete) {
      const scale = 4.5;
      const w = backSprite.naturalWidth * scale;
      const h = backSprite.naturalHeight * scale;

      ctx.drawImage(backSprite, viewW * 0.25 - w / 2, viewH - h + 160, w, h);
    }
  }

  function drawButtons() {
    if (uiMode !== "menu") return;

    drawButton("Catch", viewW - 140, viewH - 80);
    drawButton("Run", viewW - 140, viewH - 40);
    drawButton("Swap", viewW - 140, viewH - 120);
  }

  function drawButton(text, x, y, selected = false) {
    // outer border (zwart)
    ctx.fillStyle = "#000";
    ctx.fillRect(x - 2, y - 2, 104, 34);

    // inner background
    ctx.fillStyle = selected ? "#ffd84d" : "#f8f8f8";
    ctx.fillRect(x, y, 100, 30);

    // inner border (donkergrijs)
    ctx.strokeStyle = "#444";
    ctx.strokeRect(x, y, 100, 30);

    // tekst
    ctx.fillStyle = "#000";
    ctx.font = "bold 14px Arial";
    ctx.textAlign = "left";
    ctx.fillText(text, x + 10, y + 20);
  }

  function drawPokeball() {
    if (!catchAnimation.active || !pokeballImg.complete) return;

    const t = catchAnimation.timer;

    const centerX = viewW * 0.72;
    const centerY = viewH * 0.55;

    let rotation = 0;
    let baseScale = 1;

    /* -------------------- SHRINK -------------------- */
    if (catchAnimation.phase === "shrink") {
      const p = Math.min(t / 0.5, 1);
      baseScale = 3 - 2 * p;
    } else if (catchAnimation.phase === "shake") {
      /* -------------------- SHAKE -------------------- */
      baseScale = 1;

      const shakeDuration = 0.9;
      const total = catchAnimation.timer;

      const shakeIndex = Math.floor(total / shakeDuration);
      const tShake = (total % shakeDuration) / shakeDuration;

      const isShaking = tShake < 0.3;

      if (shakeIndex < 3 && isShaking) {
        const intensity = 0.22 * (1 - shakeIndex * 0.15);
        rotation = Math.sin(tShake * Math.PI * 10) * intensity;
      }
    } else if (catchAnimation.phase === "done") {
      /* -------------------- DONE -------------------- */
      baseScale = 1;
      rotation = 0;
    }

    const size = 36;

    ctx.save();
    ctx.translate(centerX, centerY + size / 2);
    ctx.rotate(rotation);
    ctx.scale(baseScale, baseScale);

    if (catchAnimation.phase === "done" && catchAnimation.success) {
      ctx.filter = "brightness(0.5)";
    }

    ctx.drawImage(pokeballImg, -size / 2, -size, size, size);

    ctx.restore();

    ctx.globalAlpha = 1;
    ctx.filter = "none";
  }

  function drawMessageBox() {
    if (uiMode !== "message") return;

    ctx.fillStyle = "#000";
    ctx.fillRect(20, viewH - 100, viewW - 40, 80);

    ctx.fillStyle = "#fff";
    ctx.fillRect(25, viewH - 95, viewW - 50, 70);

    ctx.fillStyle = "#000";
    ctx.font = "16px Arial";
    ctx.fillText(battleMessage, 40, viewH - 55);
  }

  /* -------------------- CLICK FIX -------------------- */
  canvas.addEventListener("click", async (e) => {
    if (gameState === "encounter" && uiMode === "message") {
      nextMessage();
      return;
    }

    const rect = canvas.getBoundingClientRect();
    const x = (e.clientX - rect.left) / scale;
    const y = (e.clientY - rect.top) / scale;

    // De swap knop
    if (partyOpen) {
      const team = loadPokemon();
      const boxSize = 90;
      const startX = (viewW - team.length * (boxSize + 10)) / 2;
      const startY = viewH / 2 - 40;

      for (let i = 0; i < team.length; i++) {
        const x0 = startX + i * (boxSize + 10);

        if (
          x >= x0 &&
          x <= x0 + boxSize &&
          y >= startY &&
          y <= startY + boxSize
        ) {
          const mon = team[i];

          backSprite = new Image();
          backSprite.src = mon.backSprite || mon.frontSprite || "";

          // Cry van je eigen Pokémon
          const cryUrl = mon?.cries?.latest || mon?.cries?.legacy;

          if (cryUrl) {
            const cry = new Audio(cryUrl);
            cry.volume = 0.2;
            cry.play().catch(() => {});
          }

          localStorage.setItem("activePokemonIndex", i);
          partyOpen = false;
          return;
        }
      }

      partyOpen = false;
      return;
    }

    if (gameState !== "encounter") return;

    if (
      x > viewW - 140 &&
      x < viewW - 40 &&
      y > viewH - 120 &&
      y < viewH - 90
    ) {
      playSound(sounds.button);
      partyOpen = true;
    }

    // De catch knop
    if (x > viewW - 140 && x < viewW - 40 && y > viewH - 80 && y < viewH - 50) {
      const rateRes = await fetchJSON(
        `https://pokeapi.co/api/v2/pokemon-species/${currentPokemon.id}`,
      );

      const rate = rateRes?.capture_rate || 45;

      const team = loadPokemon();

      if (team.length >= 6) {
        showMessage("Your party is full!");
        playSound(sounds.button);
        return;
      }

      playSound(sounds.throw);
      const success = Math.random() < rate / 255;

      catchAnimation = {
        active: true,
        phase: "shrink",
        timer: 0,
        shakes: 0,
        success,
      };
    }

    // Run knop
    if (x > viewW - 140 && x < viewW - 40 && y > viewH - 40 && y < viewH - 10) {
      playSound(sounds.run);
      endEncounter();
    }
  });

  /* -------------------- LOOP -------------------- */
  function loop(t) {
    const dt = (t - lastTime) / 1000;
    lastTime = t;

    update(dt);
    updateAnimation(dt);
    draw();

    requestAnimationFrame(loop);
  }

  img.onload = () => {
    playerImg.onload = () => {
      lastTime = performance.now();
      requestAnimationFrame(loop);
    };
  };

  function showMessage(text) {
    messageQueue.push(text);

    if (uiMode !== "message") {
      nextMessage();
    }
  }

  function nextMessage() {
    if (messageQueue.length === 0) {
      uiMode = "menu";
      battleMessage = "";
      return;
    }

    uiMode = "message";
    battleMessage = messageQueue.shift();
  }
</script>
