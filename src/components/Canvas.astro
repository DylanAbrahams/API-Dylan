---
const { width = 900, height = 500 } = Astro.props;
---

<canvas id="main-canvas" width={width} height={height}></canvas>

<style>
  canvas {
    display: block;
    margin: 20px auto;
    border: 2px solid #333;
    background: #111;
  }
</style>

<script type="module">
  import { walls } from "../game/walls.js";
  import { grass } from "../game/grass.js";

  const canvas = document.getElementById("main-canvas");
  const ctx = canvas.getContext("2d");

  const img = new Image();
  img.src = "/src/assets/Route1-Tilemap.png";

  const playerImg = new Image();
  playerImg.src = "/src/assets/Trainer_Spritesheet.png";

  const viewW = canvas.width;
  const viewH = canvas.height;

  const SPRITE_SIZE = 64;
  const FRAME_COUNT = 4;

  let lastTime = 0;

  // ✅ LOAD SAVE
  const saved = JSON.parse(localStorage.getItem("playerState"));

  const player = {
    x: saved?.x ?? 970,
    y: saved?.y ?? 1060,
    size: 36,
    speed: 240,
    frame: 0,
    direction: saved?.direction ?? 0,
    moving: false
  };

  const keys = {};
  window.addEventListener("keydown", (e) => keys[e.key] = true);
  window.addEventListener("keyup", (e) => keys[e.key] = false);

  function savePlayer() {
    localStorage.setItem("playerState", JSON.stringify({
      x: player.x,
      y: player.y,
      direction: player.direction
    }));
  }

  function isColliding(x, y) {
    const half = player.size / 2;

    return walls.some(w =>
      x + half > w.x &&
      x - half < w.x + w.w &&
      y + half > w.y &&
      y - half < w.y + w.h
    );
  }

  function isInGrass(x, y) {
    const half = player.size / 2;

    return grass.some(g =>
      x + half > g.x &&
      x - half < g.x + g.w &&
      y + half > g.y &&
      y - half < g.y + g.h
    );
  }

  let encounterCooldown = 0;

  function update(deltaTime) {
    const mapWidth = img.width;
    const mapHeight = img.height;

    let nextX = player.x;
    let nextY = player.y;

    player.moving = false;

    const moveAmount = player.speed * deltaTime;

    let dx = 0;
    let dy = 0;

    if (keys["ArrowDown"] || keys["s"]) {
      dy += 1;
      player.direction = 0;
    }

    if (keys["ArrowUp"] || keys["w"]) {
      dy -= 1;
      player.direction = 3;
    }

    if (keys["ArrowLeft"] || keys["a"]) {
      dx -= 1;
      player.direction = 1;
    }

    if (keys["ArrowRight"] || keys["d"]) {
      dx += 1;
      player.direction = 2;
    }

    player.moving = dx !== 0 || dy !== 0;

    if (player.moving) {
      const length = Math.hypot(dx, dy);
      dx /= length;
      dy /= length;

      nextX += dx * moveAmount;
      nextY += dy * moveAmount;
    }

    const half = player.size / 2;

    // X movement
    const inBoundsX =
      nextX - half >= 0 &&
      nextX + half <= mapWidth;

    if (inBoundsX && !isColliding(nextX, player.y)) {
      player.x = nextX;
      savePlayer();
    }

    // Y movement
    const inBoundsY =
      nextY - half >= 0 &&
      nextY + half <= mapHeight;

    if (inBoundsY && !isColliding(player.x, nextY)) {
      player.y = nextY;
      savePlayer();
    }

    // 🌿 RANDOM ENCOUNTER SYSTEM
    if (player.moving && isInGrass(player.x, player.y)) {
      encounterCooldown += deltaTime;

      if (encounterCooldown > 0.3) {
        encounterCooldown = 0;

        const chance = Math.random();

        if (chance < 0.08) {
          window.location.href = "/randomizer";
        }
      }
    } else {
      encounterCooldown = 0;
    }
  }

  let frameTimer = 0;
  const frameSpeed = 0.1;

  function updateAnimation(deltaTime) {
    if (player.moving) {
      frameTimer += deltaTime;

      if (frameTimer >= frameSpeed) {
        player.frame = (player.frame + 1) % FRAME_COUNT;
        frameTimer = 0;
      }
    } else {
      player.frame = 0;
    }
  }

  function draw() {
    ctx.clearRect(0, 0, viewW, viewH);

    const mapWidth = img.width;
    const mapHeight = img.height;

    let cameraX = player.x - viewW / 2;
    let cameraY = player.y - viewH / 2;

    cameraX = Math.max(0, Math.min(cameraX, mapWidth - viewW));
    cameraY = Math.max(0, Math.min(cameraY, mapHeight - viewH));

    ctx.drawImage(img, cameraX, cameraY, viewW, viewH, 0, 0, viewW, viewH);

    // 🌿 GRASS DEBUG RENDER
    ctx.fillStyle = "rgba(0, 0, 255, 0.3)";
    for (const g of grass) {
      ctx.fillRect(g.x - cameraX, g.y - cameraY, g.w, g.h);
    }

    // 🔴 WALL DEBUG
    ctx.fillStyle = "rgba(255,0,0,0.3)";
    for (const w of walls) {
      ctx.fillRect(w.x - cameraX, w.y - cameraY, w.w, w.h);
    }

    const screenX = player.x - cameraX;
    const screenY = player.y - cameraY;

    ctx.drawImage(
      playerImg,
      player.frame * SPRITE_SIZE,
      player.direction * SPRITE_SIZE,
      SPRITE_SIZE,
      SPRITE_SIZE,
      screenX - SPRITE_SIZE / 2,
      screenY - SPRITE_SIZE / 2,
      SPRITE_SIZE,
      SPRITE_SIZE
    );
  }

  function loop(currentTime) {
    const deltaTime = (currentTime - lastTime) / 1000;
    lastTime = currentTime;

    update(deltaTime);
    updateAnimation(deltaTime);
    draw();

    requestAnimationFrame(loop);
  }

  let loaded = 0;
  function checkStart() {
    loaded++;
    if (loaded === 2) {
      lastTime = performance.now();
      requestAnimationFrame(loop);
    }
  }

  img.onload = checkStart;
  playerImg.onload = checkStart;
</script>