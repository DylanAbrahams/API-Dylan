---
const { width = 900, height = 500 } = Astro.props;
---

<canvas id="main-canvas" width={width} height={height}></canvas>

<style>
  canvas {
    display: block;
    margin: 20px auto;
    border: 2px solid #333;
    background: #111;
  }
</style>

<script type="module">
import { walls } from "../game/walls.js";
import { grass } from "../game/grass.js";
import { addPokemon } from "../game/pokemonStorage.js";

/* -------------------- CONFIG -------------------- */
const ENCOUNTER_CHANCE = 0.10;
const ENCOUNTER_CHECK_RATE = 0.25;

/* -------------------- CANVAS -------------------- */
const canvas = document.getElementById("main-canvas");
const ctx = canvas.getContext("2d");

ctx.imageSmoothingEnabled = false;

const img = new Image();
img.src = "/assets/Route1-Tilemap.png";

const battleBg = new Image();
battleBg.src = "/assets/battle-bg.png";

const playerImg = new Image();
playerImg.src = "/assets/Trainer_Spritesheet.png";

const viewW = canvas.width;
const viewH = canvas.height;

const SPRITE_SIZE = 64;
const FRAME_COUNT = 4;

/* -------------------- BATTLE CONFIG -------------------- */
const BATTLE_CONFIG = {
  name: {
    x: 30,
    y: 50,
    font: "bold 26px Arial",
    color: "#fff",
    shadowBlur: 6
  },

  frontSprite: {
    scale: 3,
    anchorX: 0.72,
    anchorY: 0.5
  },

  backSprite: {
    scale: 5,
    offsetX: 0,
    offsetY: -170 
  },

  buttons: {
    x: canvas.width - 140,
    catchY: canvas.height - 80,
    runY: canvas.height - 40
  }
};

/* -------------------- STATE -------------------- */
let lastTime = 0;
let gameState = "world";
let currentPokemon = null;
let enrichedList = [];
let battleSprite = new Image();
let backSprite = new Image();

/* -------------------- PLAYER -------------------- */
const saved = JSON.parse(localStorage.getItem("playerState"));

const player = {
  x: saved?.x ?? 970,
  y: saved?.y ?? 1060,
  size: 36,
  speed: 240,
  frame: 0,
  direction: saved?.direction ?? 0,
  moving: false
};

const keys = {};
window.addEventListener("keydown", e => keys[e.key] = true);
window.addEventListener("keyup", e => keys[e.key] = false);

function savePlayer() {
  localStorage.setItem("playerState", JSON.stringify({
    x: player.x,
    y: player.y,
    direction: player.direction
  }));
}

/* -------------------- POKEMON -------------------- */
async function fetchJSON(url) {
  try {
    const res = await fetch(url);
    return await res.json();
  } catch {
    return null;
  }
}

async function enrich(list) {
  return await Promise.all(list.map(async p => {
    const d = await fetchJSON(p.url);

    return {
      ...p,
      stats: d?.stats || [],
      artwork: d?.sprites?.other?.["official-artwork"]?.front_default || "",
      frontSprite: d?.sprites?.front_default || "",
      backSprite: d?.sprites?.back_default || "",
      id: d?.id || 0
    };
  }));
}

async function loadPokemon() {
  const res = await fetch("https://pokeapi.co/api/v2/pokemon?limit=493");
  const data = await res.json();
  enrichedList = await enrich(data.results);
}

loadPokemon();

/* -------------------- ENCOUNTER -------------------- */
function weightedRandom(list, target = 50) {
  const k = 0.08;

  const weights = list.map(p => {
    const avg = p.stats.reduce((s, x) => s + x.base_stat, 0) / (p.stats.length || 1);
    return Math.exp(-k * Math.abs(avg - target));
  });

  let sum = weights.reduce((a, b) => a + b, 0);
  let rnd = Math.random() * sum;

  for (let i = 0; i < list.length; i++) {
    if ((rnd -= weights[i]) < 0) return list[i];
  }

  return list[0];
}

function startEncounter() {
  if (!enrichedList.length) return;

  gameState = "encounter";
  currentPokemon = weightedRandom(enrichedList, 50);

  battleSprite = new Image();
  battleSprite.src = currentPokemon.frontSprite;

  backSprite = new Image();
  backSprite.src = currentPokemon.backSprite;
}

function endEncounter() {
  gameState = "world";
  currentPokemon = null;
}

/* -------------------- COLLISION -------------------- */
function isColliding(x, y) {
  const half = player.size / 2;

  return walls.some(w =>
    x + half > w.x &&
    x - half < w.x + w.w &&
    y + half > w.y &&
    y - half < w.y + w.h
  );
}

function isInGrass(x, y) {
  const half = player.size / 2;

  return grass.some(g =>
    x + half > g.x &&
    x - half < g.x + g.w &&
    y + half > g.y &&
    y - half < g.y + g.h
  );
}

/* -------------------- UPDATE -------------------- */
let encounterCooldown = 0;

function update(dt) {
  if (gameState !== "world") return;

  let nextX = player.x;
  let nextY = player.y;

  player.moving = false;

  const speed = player.speed * dt;

  let dx = 0;
  let dy = 0;

  if (keys["ArrowDown"] || keys["s"]) { dy++; player.direction = 0; }
  if (keys["ArrowUp"] || keys["w"]) { dy--; player.direction = 3; }
  if (keys["ArrowLeft"] || keys["a"]) { dx--; player.direction = 1; }
  if (keys["ArrowRight"] || keys["d"]) { dx++; player.direction = 2; }

  player.moving = dx !== 0 || dy !== 0;

  if (player.moving) {
    const len = Math.hypot(dx, dy);
    dx /= len;
    dy /= len;

    nextX += dx * speed;
    nextY += dy * speed;
  }

  if (!isColliding(nextX, player.y)) player.x = nextX;
  if (!isColliding(player.x, nextY)) player.y = nextY;

  savePlayer();

  if (player.moving && isInGrass(player.x, player.y)) {
    encounterCooldown += dt;

    if (encounterCooldown > ENCOUNTER_CHECK_RATE) {
      encounterCooldown = 0;

      if (Math.random() < ENCOUNTER_CHANCE) {
        startEncounter();
      }
    }
  } else {
    encounterCooldown = 0;
  }
}

/* -------------------- ANIMATION -------------------- */
let frameTimer = 0;

function updateAnimation(dt) {
  if (player.moving) {
    frameTimer += dt;

    if (frameTimer > 0.1) {
      player.frame = (player.frame + 1) % FRAME_COUNT;
      frameTimer = 0;
    }
  } else {
    player.frame = 0;
  }
}

/* -------------------- DRAW -------------------- */
function draw() {
  ctx.clearRect(0, 0, viewW, viewH);

  let camX = player.x - viewW / 2;
  let camY = player.y - viewH / 2;

  camX = Math.max(0, Math.min(camX, img.width - viewW));
  camY = Math.max(0, Math.min(camY, img.height - viewH));

  if (gameState === "world") {
    ctx.drawImage(img, camX, camY, viewW, viewH, 0, 0, viewW, viewH);

    const sx = player.x - camX;
    const sy = player.y - camY;

    ctx.drawImage(
      playerImg,
      player.frame * SPRITE_SIZE,
      player.direction * SPRITE_SIZE,
      SPRITE_SIZE,
      SPRITE_SIZE,
      sx - SPRITE_SIZE / 2,
      sy - SPRITE_SIZE / 2,
      SPRITE_SIZE,
      SPRITE_SIZE
    );
  }

  /* -------------------- BATTLE -------------------- */
  if (gameState === "encounter" && currentPokemon) {
    ctx.drawImage(battleBg, 0, 0, viewW, viewH);

    /* NAME */
    ctx.font = BATTLE_CONFIG.name.font;
    ctx.fillStyle = BATTLE_CONFIG.name.color;
    ctx.shadowColor = "black";
    ctx.shadowBlur = BATTLE_CONFIG.name.shadowBlur;

    ctx.fillText(
      currentPokemon.name.toUpperCase(),
      BATTLE_CONFIG.name.x,
      BATTLE_CONFIG.name.y
    );

    ctx.shadowBlur = 0;

    /* FRONT SPRITE */
    if (battleSprite.complete && battleSprite.naturalWidth > 0) {
      const cfg = BATTLE_CONFIG.frontSprite;

      const drawW = battleSprite.naturalWidth * cfg.scale;
      const drawH = battleSprite.naturalHeight * cfg.scale;

      const anchorX = viewW * cfg.anchorX;
      const anchorY = viewH * cfg.anchorY;

      const x = anchorX - drawW / 2;
      const y = anchorY - drawH / 2;

      ctx.drawImage(battleSprite, x, y, drawW, drawH);
    }

    /* BACK SPRITE */
    if (backSprite.complete && backSprite.naturalWidth > 0) {
      const cfg = BATTLE_CONFIG.backSprite;

      const bw = backSprite.naturalWidth * cfg.scale;
      const bh = backSprite.naturalHeight * cfg.scale;

      const x = cfg.offsetX;
      const y = viewH - bh - cfg.offsetY;

      ctx.drawImage(backSprite, x, y, bw, bh);
    }

    /* BUTTONS */
    drawButton("Catch", BATTLE_CONFIG.buttons.x, BATTLE_CONFIG.buttons.catchY);
    drawButton("Run", BATTLE_CONFIG.buttons.x, BATTLE_CONFIG.buttons.runY);
  }
}

/* -------------------- BUTTON -------------------- */
function drawButton(text, x, y) {
  ctx.fillStyle = "#222";
  ctx.fillRect(x, y, 100, 30);

  ctx.fillStyle = "white";
  ctx.font = "14px Arial";
  ctx.fillText(text, x + 20, y + 20);
}

/* -------------------- CLICK -------------------- */
canvas.addEventListener("click", async (e) => {
  if (gameState !== "encounter") return;

  const rect = canvas.getBoundingClientRect();
  const x = e.clientX - rect.left;
  const y = e.clientY - rect.top;

  if (x > viewW - 140 && x < viewW - 40 && y > viewH - 80 && y < viewH - 50) {
    const rateRes = await fetchJSON(`https://pokeapi.co/api/v2/pokemon-species/${currentPokemon.id}`);
    const rate = rateRes?.capture_rate || 45;

    if (Math.random() < rate / 255) {
      addPokemon({
        name: currentPokemon.name,
        frontSprite: currentPokemon.frontSprite
      });

      window.dispatchEvent(new Event("pokemon-updated"));
      endEncounter();
    }
  }

  if (x > viewW - 140 && x < viewW - 40 && y > viewH - 40 && y < viewH - 10) {
    endEncounter();
  }
});

/* -------------------- LOOP -------------------- */
function loop(t) {
  const dt = (t - lastTime) / 1000;
  lastTime = t;

  update(dt);
  updateAnimation(dt);
  draw();

  requestAnimationFrame(loop);
}

img.onload = () => {
  playerImg.onload = () => {
    lastTime = performance.now();
    requestAnimationFrame(loop);
  };
};
</script>