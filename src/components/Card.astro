---
type Props = {
  name: string;
  official_artwork?: string;
  types?: string[];
  id: number;
};

const { name, official_artwork, types = [], id } = Astro.props;
---

<a href={`/pokemon/${name}`} class="card">
  <div class="top">

    <div class="meta">
      <span class="label">#{String(id).padStart(3, "0")}</span>
      <h2>{name}</h2>
    </div>

    <div class="types">
      {types.map((t) => (
        <span class={`move-type type-${t}`}>{t}</span>
      ))}
    </div>

  </div>

  <div class="image">
    {official_artwork && (
      <img src={official_artwork} alt={name} />
    )}
  </div>
</a>

<style>
  .card {
    display: block;
    background: #fff;
    border: 2px solid #ccc;
    border-radius: 10px;

    padding: 0.8rem;
    text-decoration: none;
    color: #111;

    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .card:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 10px rgba(0,0,0,0.1);
  }

  .top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .meta {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .label {
    font-size: 0.65rem;
    color: #444;
    letter-spacing: 1px;
    font-family: monospace;
  }

  h2 {
    margin: 0;
    font-size: 0.9rem;
    text-transform: capitalize;
  }

  .types {
    display: flex;
    gap: 0.3rem;
    flex-wrap: wrap;
    justify-content: flex-end;
    max-width: 100px;
  }

  .move-type {
    position: static;
    display: inline-block;
  }

  .image {
    display: flex;
    justify-content: center;
    padding: 0.5rem 0;
  }

  img {
    width: 110px;
    height: 110px;
    object-fit: contain;
  }
</style>