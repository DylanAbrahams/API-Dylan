---
type Props = {
  name: string;
  official_artwork?: string;
  types?: string[];
  id: number;
};

const { name, official_artwork, types = [], id } = Astro.props;

const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const primaryType = types?.[0] ?? "normal";
---

<a href={`/pokemon/${name}`} class="card-shell">

  <div class={`card-face type-${primaryType}`}>

    <div class="top">
      <div class="name">{cap(name)}</div>
      <div class="hp">#{String(id).padStart(3, "0")}</div>
    </div>

    <div class="type-line">
      {types.length > 0 ? types.map(cap).join(" / ") : "Normal"} Pokémon
    </div>

    <div class="art">
      {official_artwork && (
        <img src={official_artwork} alt={name} />
      )}
    </div>

  </div>

</a>

<style>
/* De kleuren van de kaarten staan in global.css*/

.card-shell {
  display: block;
  text-decoration: none;
  transition: transform 0.2s ease;
  border-radius:10px;

  &:hover {
    transform: scale(1.05);
  }
}

.card-face {
  padding: 12px;
  font-family: Arial, sans-serif;
  color: #111;

  border: 2px solid #000;

  box-shadow:
    0 12px 30px rgba(0,0,0,0.25),
    inset 0 0 0 2px rgba(255,255,255,0.25);
}


.top {
  display: flex;
  justify-content: space-between;
  font-size: 16px;
  font-weight: bold;
  text-transform: capitalize;
}

.type-line {
  font-size: 11px;
  margin-bottom: 8px;
  padding-bottom: 6px;

  box-shadow: inset 0 -1px 0 rgba(0,0,0,0.3);
}

.art {
  background: rgba(255,255,255,0.85);
  height: 170px;

  display: flex;
  align-items: center;
  justify-content: center;
}

.art img {
  max-height: 150px;
}
</style>