---
type Props = {
  name: string;
  official_artwork?: string;
  types?: string[];
  id: number;
};

const { name, official_artwork, types = [], id } = Astro.props;

const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const primaryType = types?.[0] ?? "normal";
---

<a href={`/pokemon/${name}`} class="card-shell">

  <div class={`card-face type-${primaryType}`}>

    <div class="top">
      <div class="name">{cap(name)}</div>
      <div class="hp">#{String(id).padStart(3, "0")}</div>
    </div>

    <div class="type-line">
      {types.length > 0 ? types.map(cap).join(" / ") : "Normal"} Pokémon
    </div>

    <div class="art">
      {official_artwork && (
        <img src={official_artwork} alt={name} />
      )}
    </div>

  </div>

</a>

<style>
.card-shell {
  display: block;
  text-decoration: none;
  transition: transform 0.2s ease;
  border-radius:10px;

  &:hover {
    transform: scale(1.05);
  }
}

/* BASE CARD*/
.card-face {
  padding: 12px;
  font-family: Arial, sans-serif;
  color: #111;

  border: 2px solid #000;

  box-shadow:
    0 12px 30px rgba(0,0,0,0.25),
    inset 0 0 0 2px rgba(255,255,255,0.25);
}

/* ===== TYPE COLORS ===== */

.type-normal { background: linear-gradient(#f5f5f5, #e0e0e0); }
.type-fire { background: linear-gradient(#fff3e0, #ffe0b2); }
.type-water { background: linear-gradient(#e3f2fd, #bbdefb); }
.type-electric { background: linear-gradient(#fffde7, #fff59d); }
.type-grass { background: linear-gradient(#e8f5e9, #c8e6c9); }
.type-ice { background: linear-gradient(#e0f7fa, #b2ebf2); }
.type-fighting { background: linear-gradient(#ffebee, #ef9a9a); }
.type-poison { background: linear-gradient(#f3e5f5, #ce93d8); }
.type-ground { background: linear-gradient(#efebe9, #d7ccc8); }
.type-flying { background: linear-gradient(#e1f5fe, #b3e5fc); }
.type-psychic { background: linear-gradient(#fce4ec, #f8bbd0); }
.type-bug { background: linear-gradient(#f1f8e9, #dcedc8); }
.type-rock { background: linear-gradient(#fbe9e7, #bcaaa4); }
.type-ghost { background: linear-gradient(#ede7f6, #b39ddb); }
.type-dragon { background: linear-gradient(#e8eaf6, #9fa8da); }
.type-dark { background: linear-gradient(#efebe9, #bcaaa4); }
.type-steel { background: linear-gradient(#eceff1, #b0bec5); }
.type-fairy { background: linear-gradient(#fce4ec, #f48fb1); }

/* ===== LAYOUT ===== */

.top {
  display: flex;
  justify-content: space-between;
  font-size: 16px;
  font-weight: bold;
  text-transform: capitalize;
}

.type-line {
  font-size: 11px;
  margin-bottom: 8px;
  padding-bottom: 6px;

  box-shadow: inset 0 -1px 0 rgba(0,0,0,0.3);
}

.art {
  background: rgba(255,255,255,0.85);
  height: 170px;

  display: flex;
  align-items: center;
  justify-content: center;
}

.art img {
  max-height: 150px;
}
</style>