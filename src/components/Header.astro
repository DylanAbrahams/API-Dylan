---
const currentPath = Astro.url.pathname;
---

<header class="header">
  <div class="container">

    <div class="brand">
      <h1>Pokédex</h1>
      <span class="subtitle">Research Interface</span>
    </div>

    <nav class="nav-links">
      <a href="/" class={currentPath === "/" ? "active" : ""}>
        Overzicht
      </a>

      <a href="/randomizer" class={currentPath === "/randomizer" ? "active" : ""}>
        Randomizer
      </a>

      <a href="/world" class={currentPath === "/world" ? "active" : ""}>
        Wereld
      </a>
    </nav>

  </div>
</header>

<style>
  .header {
    background: #ffffff;
    border-bottom: 2px solid #e5e7eb;
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 1rem 1.5rem;

    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    display: flex;
    flex-direction: column;
  }

  .brand h1 {
    margin: 0;
    font-size: 1.2rem;
    letter-spacing: 1px;
  }

  .subtitle {
    font-size: 0.7rem;
    color: #6b7280;
    letter-spacing: 1px;
  }

  .nav-links {
    display: flex;
    gap: 0.5rem;
  }

  .nav-links a {
    text-decoration: none;
    font-size: 0.85rem;
    color: #374151;

    padding: 0.4rem 0.7rem;
    border-radius: 6px;

    transition: background 0.15s, color 0.15s;
  }

  .nav-links a:hover {
    background: #f3f4f6;
    color: #111;
  }

  /* ACTIVE TAB */
  .nav-links a.active {
    background: #e5e7eb;
    color: #111;
    font-weight: 600;
  }
</style>