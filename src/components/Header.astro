---
const currentPath = Astro.url.pathname;

const isMap = currentPath.startsWith("/world");

const href = isMap ? "/" : "/world";
const label = isMap ? "POKEDEX" : "WORLD";
---

<div class="hud">
  <a href={href} class="btn">
    {label}
  </a>
</div>

<style>
  .hud {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 999;
  }

  .btn {
    position: absolute;
    top: 18px;
    right: 18px;

    pointer-events: auto;

    padding: 0.75rem 1.1rem;

    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 2px;

    text-transform: uppercase;
    text-decoration: none;

    color: #fff;

    background: linear-gradient(
      180deg,
      #ef4444,
      #b91c1c,
      #7f1d1d
    );

    border: 2px solid #111;
    border-radius: 10px;

    box-shadow:
      0 6px 0 #111,
      inset 0 1px 0 rgba(255, 255, 255, 0.35);

    text-shadow: 0 1px 0 rgba(0, 0, 0, 0.4);

    transition: all 0.12s ease;
  }

  .btn:hover {
    transform: scale(1.05);
    filter: brightness(1.1);
  }

  .btn:active {
    transform: translateY(4px);
    box-shadow:
      0 2px 0 #111,
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
  }

  @media (max-width: 600px) {
    .btn {
      top: 10px;
      right: 10px;
      font-size: 0.65rem;
      padding: 0.6rem 0.9rem;
    }
  }
</style>