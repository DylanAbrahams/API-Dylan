---
import { POKEMON_URL } from "./../shared.js";
import MainLayout from "../../layouts/MainLayout.astro";

const { name } = Astro.params;

type PokemonType = {
  id: number;
  name: string;
  height: number;
  weight: number;
  sprites: {
    other: {
      "official-artwork": { front_default: string };
    };
  };
  types: { type: { name: string } }[];
  abilities: { ability: { name: string }; is_hidden: boolean }[];
  stats: { stat: { name: string }; base_stat: number }[];
  moves: { move: { name: string } }[];
};

type SpeciesType = {
  genera: { genus: string; language: { name: string } }[];
};

let pokemon: PokemonType | null = null;
let species: SpeciesType | null = null;

const res = await fetch(`https://pokeapi.co/api/v2/pokemon/${name}`);
if (res.ok) pokemon = await res.json();

if (pokemon) {
  const speciesRes = await fetch(
    `https://pokeapi.co/api/v2/pokemon-species/${pokemon.name}`
  );
  if (speciesRes.ok) species = await speciesRes.json();
}

export async function getStaticPaths() {
  const res = await fetch(POKEMON_URL);
  const data = await res.json();

  return data.results.map((poke: { name: string }) => ({
    params: { name: poke.name },
  }));
}

const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

const primaryType =
  pokemon?.types?.[0]?.type?.name ?? "normal";

const hp =
  pokemon?.stats?.find(s => s.stat.name === "hp")?.base_stat ?? 0;

const atk =
  pokemon?.stats?.find(s => s.stat.name === "attack")?.base_stat ?? 0;

const def =
  pokemon?.stats?.find(s => s.stat.name === "defense")?.base_stat ?? 0;

const spd =
  pokemon?.stats?.find(s => s.stat.name === "speed")?.base_stat ?? 0;

const moves =
  pokemon?.moves?.slice(0, 2) ?? [];

const speciesName =
  species?.genera?.find(g => g.language.name === "en")?.genus ??
  "Pokémon";
---

<MainLayout title={pokemon ? cap(pokemon.name) : "Pokémon Card"}>

{pokemon ? (
  <div class="page">
    <div class="card-shell">
      <div class={`card-face type-${primaryType}`}>

        <!-- HEADER (TCG STYLE) -->
        <div class="top">
          <div class="name">{cap(pokemon.name)}</div>
          <div class="hp">HP {hp}</div>
        </div>

        <div class="type-line">
          {pokemon.types.map(t => cap(t.type.name)).join(" / ")} Pokémon
        </div>

        <!-- ART -->
        <div class="art">
          <img
            src={pokemon.sprites.other["official-artwork"].front_default}
            alt={pokemon.name}
          />
        </div>

        <!-- INFO STRIP -->
        <div class="info-line">
          <span>{speciesName}</span>
          <span class="dot">•</span>
          <span>Height: {pokemon.height / 10}m</span>
          <span class="dot">•</span>
          <span>Weight: {pokemon.weight / 10}kg</span>
        </div>

        <!-- ABILITY -->
        {pokemon.abilities.length > 0 && (
          <div class="box">
            <div class="title">Ability</div>
            <div class="row">
              ⚡ {cap(pokemon.abilities[0].ability.name)}
              {pokemon.abilities[0].is_hidden && (
                <span class="tag">Hidden</span>
              )}
            </div>
          </div>
        )}

        <!-- ATTACKS (MAX 2) -->
        <div class="box">
          <div class="title">Attacks</div>

          {moves.map((m, i) => (
            <div class="attack">
              <div class="attack-name">
                {cap(m.move.name.replace("-", " "))}
              </div>
              <div class="attack-dmg">
                {30 + i * 20}
              </div>
            </div>
          ))}
        </div>

        <!-- FOOTER STATS -->
        <div class="footer">
          <span>ATK {atk}</span>
          <span>DEF {def}</span>
          <span>SPD {spd}</span>
        </div>

      </div>
    </div>
  </div>
) : (
  <p>Pokémon niet gevonden</p>
)}

<style>
/* PAGE */
/* PAGE */
.page {
  min-height: 100vh;

  display: flex;
  justify-content: center;
  align-items: center;

  /* base color matches your global */
  background: #f0f8ff;

  /* subtle lab grid overlay */
  background-image:
    linear-gradient(to right, rgba(0,0,0,0.04) 1px, transparent 1px),
    linear-gradient(to bottom, rgba(0,0,0,0.04) 1px, transparent 1px);

  background-size: 40px 40px;
}

/* CARD BASE (your style preserved) */
.card-shell {
  width: 380px;
  background: linear-gradient(145deg, #ffe066, #f2c94c);

  box-shadow:
    0 20px 60px rgba(0,0,0,0.45),
    inset 0 0 0 2px rgba(255,255,255,0.25);

  padding: 12px;
}

.card-face {
  padding: 12px;
  font-family: Arial, sans-serif;
  color: #111;
}

/* TYPES (UNCHANGED) */
.type-fire { background: linear-gradient(#fff3e0, #ffe0b2); }
.type-water { background: linear-gradient(#e3f2fd, #bbdefb); }
.type-grass { background: linear-gradient(#e8f5e9, #c8e6c9); }
.type-electric { background: linear-gradient(#fffde7, #fff59d); }
.type-psychic { background: linear-gradient(#fce4ec, #f8bbd0); }
.type-ice { background: linear-gradient(#e0f7fa, #b2ebf2); }
.type-dark { background: linear-gradient(#efebe9, #bcaaa4); }
.type-fairy { background: linear-gradient(#fce4ec, #f48fb1); }
.type-normal { background: linear-gradient(#f5f5f5, #e0e0e0); }

/* HEADER (more spacing, same vibe) */
.top {
  display: flex;
  justify-content: space-between;
  font-size: 22px;
  font-weight: bold;
  text-transform: capitalize;
}

.hp {
  color: #c62828;
}

/* TYPE LINE */
.type-line {
  font-size: 12px;
  margin-bottom: 8px;
  padding-bottom: 6px;
  box-shadow: inset 0 -1px 0 rgba(0,0,0,0.3);
}

/* ART */
.art {
  background: rgba(255,255,255,0.85);
  height: 240px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.art img {
  max-height: 220px;
}

/* INFO STRIP (cleaner alignment) */
.info-line {
  display: flex;
  justify-content: center;
  gap: 6px;
  font-size: 10px;
  font-weight: bold;
  margin: 6px 0 10px;
  padding: 4px 6px;
  background: rgba(255,255,255,0.25);
  box-shadow: inset 0 0 0 1px rgba(0,0,0,0.25);
  text-transform: capitalize;
}

.dot { opacity: 0.6; }

/* BOXES (same style, cleaner spacing) */
.box {
  background: rgba(255,255,255,0.3);
  margin-bottom: 8px;
  padding: 8px;
  box-shadow: inset 0 0 0 1px rgba(0,0,0,0.25);
}

.title {
  font-size: 12px;
  font-weight: bold;
  margin-bottom: 6px;
}

/* ROWS */
.row {
  display: flex;
  justify-content: space-between;
  font-size: 12px;
}

/* ATTACKS (TCG feel preserved) */
.attack {
  display: flex;
  justify-content: space-between;
  font-size: 12px;
  padding: 4px 0;
  border-top: 1px solid rgba(0,0,0,0.2);
}

.attack:first-child {
  border-top: none;
}

.attack-name {
  text-transform: capitalize;
}

.attack-dmg {
  font-weight: bold;
}

/* FOOTER */
.footer {
  display: flex;
  justify-content: space-between;
  font-size: 10px;
  margin-top: 8px;
  font-weight: bold;
  opacity: 0.85;
}

/* TAG */
.tag {
  font-size: 9px;
  background: rgba(0,0,0,0.1);
  padding: 2px 4px;
  margin-left: 6px;
  border-radius: 4px;
}
</style>

</MainLayout>