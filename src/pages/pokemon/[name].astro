---
import { POKEMON_URL } from "./../shared.js";
import MainLayout from "../../layouts/MainLayout.astro";

const { name } = Astro.params;

type PokemonType = {
  id: number;
  name: string;
  height: number;
  weight: number;
  sprites: {
    other: {
      "official-artwork": { front_default: string };
    };
  };
  types: { type: { name: string } }[];
  abilities: { ability: { name: string }; is_hidden: boolean }[];
  stats: { stat: { name: string }; base_stat: number }[];
  moves: { move: { name: string } }[];
};

// Species = extra info zoals genus (soortnaam), evoluties, etc.
type SpeciesType = {
  genera: { genus: string; language: { name: string } }[];
};

let pokemon: PokemonType | null = null;
let species: SpeciesType | null = null;

const res = await fetch(`https://pokeapi.co/api/v2/pokemon/${name}`);
if (res.ok) pokemon = await res.json();

/* -------- PREV / NEXT -------- */
let prevPokemon: PokemonType | null = null;
let nextPokemon: PokemonType | null = null;

if (pokemon) {
  const prevId = pokemon.id > 1 ? pokemon.id - 1 : null;
  const nextId = pokemon.id + 1;

  // Vorige 
  if (prevId) {
    const resPrev = await fetch(`https://pokeapi.co/api/v2/pokemon/${prevId}`);
    if (resPrev.ok) prevPokemon = await resPrev.json();
  }

  // Volgende 
  const resNext = await fetch(`https://pokeapi.co/api/v2/pokemon/${nextId}`);
  if (resNext.ok) nextPokemon = await resNext.json();
}

// Huidige 
if (pokemon) {
  const speciesRes = await fetch(
    `https://pokeapi.co/api/v2/pokemon-species/${pokemon.name}`
  );
  if (speciesRes.ok) species = await speciesRes.json();
}

export async function getStaticPaths() {
  const res = await fetch(POKEMON_URL);
  const data = await res.json();

  return data.results.map((poke: { name: string }) => ({
    params: { name: poke.name },
  }));
}

const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

const primaryType = pokemon?.types?.[0]?.type?.name ?? "normal";

const getStat = (name: string, p: PokemonType) =>
  p.stats.find(s => s.stat.name === name)?.base_stat ?? 0;

const movesMain = pokemon?.moves?.slice(0, 2) ?? [];

const speciesName =
  species?.genera?.find(g => g.language.name === "en")?.genus ??
  "Pokémon";
---

<MainLayout title={pokemon ? cap(pokemon.name) : "Pokémon Card"}>

{pokemon ? (
  <div class="page">

    <div class="card-row">

      <!-- PREVIOUS CARD -->
      {prevPokemon && (
        <a href={`/pokemon/${prevPokemon.name}`} class="side-card prev-card">
          <div class="card-shell">
            <div class={`card-face type-${prevPokemon.types[0].type.name}`}>

              <div class="top">
                <div class="name">{cap(prevPokemon.name)}</div>
                <div class="hp">
                  HP {getStat("hp", prevPokemon)}
                </div>
              </div>

              <div class="type-line">
                {prevPokemon.types.map(t => cap(t.type.name)).join(" / ")} Pokémon
              </div>

              <div class="art">
                <img
                  src={prevPokemon.sprites.other["official-artwork"].front_default}
                  alt={prevPokemon.name}
                />
              </div>

              
              <div class="info-line">
                <span>{prevPokemon.name}</span>
                <span class="dot">•</span>
                <span>Height: {prevPokemon.height / 10}m</span>
                <span class="dot">•</span>
                <span>Weight: {prevPokemon.weight / 10}kg</span>
              </div>

              {prevPokemon.abilities.length > 0 && (
                <div class="box">
                  <div class="title">Ability</div>
                  <div class="row">
                    ⚡ {cap(prevPokemon.abilities[0].ability.name)}
                    {prevPokemon.abilities[0].is_hidden && (
                      <span class="tag">Hidden</span>
                    )}
                  </div>
                </div>
              )}

              <div class="box">
                <div class="title">Attacks</div>
                {prevPokemon.moves.slice(0, 2).map((m, i) => (
                  <div class="attack">
                    <div class="attack-name">
                      {cap(m.move.name.replace("-", " "))}
                    </div>
                    <div class="attack-dmg">{30 + i * 20}</div>
                  </div>
                ))}
              </div>

              <div class="footer">
                <span>ATK {getStat("attack", prevPokemon)}</span>
                <span>DEF {getStat("defense", prevPokemon)}</span>
                <span>SPD {getStat("speed", prevPokemon)}</span>
              </div>

            </div>
          </div>
        </a>
      )}

      <!-- MAIN CARD -->
      <div class="card-shell">
        <div class={`card-face type-${primaryType}`}>

          <div class="top">
            <div class="name">{cap(pokemon.name)}</div>
            <div class="hp">HP {getStat("hp", pokemon)}</div>
          </div>

          <div class="type-line">
            {pokemon.types.map(t => cap(t.type.name)).join(" / ")} Pokémon
          </div>

          <div class="art">
            <img
              src={pokemon.sprites.other["official-artwork"].front_default}
              alt={pokemon.name}
            />
          </div>

          <div class="info-line">
            <span>{speciesName}</span>
            <span class="dot">•</span>
            <span>Height: {pokemon.height / 10}m</span>
            <span class="dot">•</span>
            <span>Weight: {pokemon.weight / 10}kg</span>
          </div>

          {pokemon.abilities.length > 0 && (
            <div class="box">
              <div class="title">Ability</div>
              <div class="row">
                ⚡ {cap(pokemon.abilities[0].ability.name)}
                {pokemon.abilities[0].is_hidden && (
                  <span class="tag">Hidden</span>
                )}
              </div>
            </div>
          )}

          <div class="box">
            <div class="title">Attacks</div>
            {/* Het inzetten van de juiste moves is met ChatGPT gedaan */}
            {movesMain.map((m, i) => (
              <div class="attack">
                <div class="attack-name">
                  {cap(m.move.name.replace("-", " "))}
                </div>
                <div class="attack-dmg">{30 + i * 20}</div>
              </div>
            ))}
          </div>

          <div class="footer">
            <span>ATK {getStat("attack", pokemon)}</span>
            <span>DEF {getStat("defense", pokemon)}</span>
            <span>SPD {getStat("speed", pokemon)}</span>
          </div>

        </div>
      </div>

      <!-- NEXT CARD -->
      {nextPokemon && (
        <a href={`/pokemon/${nextPokemon.name}`} class="side-card next-card">
          <div class="card-shell">
            <div class={`card-face type-${nextPokemon.types[0].type.name}`}>

              <div class="top">
                <div class="name">{cap(nextPokemon.name)}</div>
                <div class="hp">
                  HP {getStat("hp", nextPokemon)}
                </div>
              </div>

              <div class="type-line">
                {nextPokemon.types.map(t => cap(t.type.name)).join(" / ")} Pokémon
              </div>

              <div class="art">
                <img
                  src={nextPokemon.sprites.other["official-artwork"].front_default}
                  alt={nextPokemon.name}
                />
              </div>

              <div class="info-line">
                <span>{nextPokemon.name}</span>
                <span class="dot">•</span>
                <span>Height: {nextPokemon.height / 10}m</span>
                <span class="dot">•</span>
                <span>Weight: {nextPokemon.weight / 10}kg</span>
              </div>

              {nextPokemon.abilities.length > 0 && (
                <div class="box">
                  <div class="title">Ability</div>
                  <div class="row">
                    ⚡ {cap(nextPokemon.abilities[0].ability.name)}
                    {nextPokemon.abilities[0].is_hidden && (
                      <span class="tag">Hidden</span>
                    )}
                  </div>
                </div>
              )}

              <div class="box">
                <div class="title">Attacks</div>
                {nextPokemon.moves.slice(0, 2).map((m, i) => (
                  <div class="attack">
                    <div class="attack-name">
                      {cap(m.move.name.replace("-", " "))}
                    </div>
                    <div class="attack-dmg">{30 + i * 20}</div>
                  </div>
                ))}
              </div>

              <div class="footer">
                <span>ATK {getStat("attack", nextPokemon)}</span>
                <span>DEF {getStat("defense", nextPokemon)}</span>
                <span>SPD {getStat("speed", nextPokemon)}</span>
              </div>

            </div>
          </div>
        </a>
      )}

    </div>
  </div>
) : (
  <p>Pokémon niet gevonden</p>
)}

<style>
  /* De kleuren van de kaarten staan in global.css */

.page {
  min-height: 80vh;
  display: flex;
  justify-content: center;
  align-items: center;
  background: #f0f8ff;
}
.card-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20px;
}

.side-card {
  transform: scale(0.75);
  opacity: 0.5;
  transition: all 0.25s ease;
  text-decoration: none;
}
.side-card:hover {
  transform: scale(0.85);
  opacity: 0.85;
}
.prev-card {
  rotate:-3deg;
}
.next-card {
  rotate:3deg;
}

.card-shell {
  width: 380px;
  background: linear-gradient(145deg, #ffe066, #f2c94c);
  box-shadow: 0 20px 60px rgba(0,0,0,0.45),
              inset 0 0 0 2px rgba(255,255,255,0.25);
  padding: 12px;
}

.card-face {
  padding: 12px;
  font-family: Arial, sans-serif;
  color: #111;
}


.top {
  display: flex;
  justify-content: space-between;
  font-size: 22px;
  font-weight: bold;
  text-transform: capitalize;
}

.hp {
  color: #c62828;
}

.type-line {
  font-size: 12px;
  margin-bottom: 8px;
  padding-bottom: 6px;
  box-shadow: inset 0 -1px 0 rgba(0,0,0,0.3);
}

.art {
  background: rgba(255,255,255,0.85);
  height: 240px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.art img {
  max-height: 220px;
}

.info-line {
  display: flex;
  justify-content: center;
  gap: 6px;
  font-size: 10px;
  font-weight: bold;
  margin: 6px 0 10px;
  padding: 4px 6px;
  background: rgba(255,255,255,0.25);
  box-shadow: inset 0 0 0 1px rgba(0,0,0,0.25);
  text-transform: capitalize;
}

.dot {
  opacity: 0.6;
}

.box {
  background: rgba(255,255,255,0.3);
  margin-bottom: 8px;
  padding: 8px;
  box-shadow: inset 0 0 0 1px rgba(0,0,0,0.25);
}

.title {
  font-size: 12px;
  font-weight: bold;
  margin-bottom: 6px;
}

.row {
  display: flex;
  justify-content: space-between;
  font-size: 12px;
}

.attack {
  display: flex;
  justify-content: space-between;
  font-size: 12px;
  padding: 4px 0;
  border-top: 1px solid rgba(0,0,0,0.2);
}

.attack:first-child {
  border-top: none;
}

.footer {
  display: flex;
  justify-content: space-between;
  font-size: 10px;
  margin-top: 8px;
  font-weight: bold;
  opacity: 0.85;
}

.tag {
  font-size: 9px;
  background: rgba(0,0,0,0.1);
  padding: 2px 4px;
  margin-left: 6px;
  border-radius: 4px;
}

@media (max-width: 768px) {
  .prev-card,
  .next-card {
    display: none;
  }

  .card-row {
    gap: 0;
  }
}
</style>
</MainLayout>