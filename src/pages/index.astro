---
type Pokemon = { 
  name: string; 
  url: string; 
  front_default?: string; 
  front_shiny?: string; 
  official_artwork?: string;
};

const API_URL = "https://pokeapi.co/api/v2/pokemon?limit=50"; // 50 voor performance
let pokemonList: Pokemon[] = [];

try {
  const response = await fetch(API_URL);
  const data = await response.json();

  if (data.results) {
    // Voor elke Pokémon extra fetch voor sprites
    pokemonList = await Promise.all(
      data.results.map(async (poke: Pokemon) => {
        try {
          const res = await fetch(poke.url);
          const details = await res.json();
          return {
            ...poke,
            front_default: details.sprites.front_default,
            front_shiny: details.sprites.front_shiny,
            official_artwork: details.sprites.other["official-artwork"].front_default,
          };
        } catch {
          return poke; // fallback als fetch faalt
        }
      })
    );
  }
} catch (error) {
  console.error("Fout bij ophalen Pokémon:", error);
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Pokémon Lijst met Afbeeldingen</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        padding: 2rem;
        background-color: #f0f8ff;
      }
      h1 {
        color: #ff0000;
        margin-bottom: 1rem;
      }
      ul {
        list-style: none;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
      }
      li {
        background-color: #fff;
        padding: 1rem;
        border-radius: 12px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.15);
        text-align: center;
        width: 150px;
      }
      img {
        width: 80px;
        height: 80px;
        display: block;
        margin: 0 auto 0.5rem;
      }
      .artwork {
        width: 120px;
        height: 120px;
        margin-top: 0.5rem;
      }
    </style>
  </head>
  <body>
    <h1>Pokémon Lijst</h1>

    {pokemonList.length > 0 ? (
      <ul>
        {pokemonList.map((poke) => (
          <li>
            {poke.front_default && <img src={poke.front_default} alt={poke.name} />}
            {poke.front_shiny && <img src={poke.front_shiny} alt={`${poke.name} shiny`} />}
            {poke.official_artwork && <img class="artwork" src={poke.official_artwork} alt={`${poke.name} artwork`} />}
            <p>{poke.name}</p>
          </li>
        ))}
      </ul>
    ) : (
      <p>Geen Pokémon gevonden of fout bij ophalen.</p>
    )}
  </body>
</html>