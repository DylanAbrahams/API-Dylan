---
import { POKEMON_URL } from "./shared.js";
import MainLayout from "../layouts/MainLayout.astro";
import Card from "../components/Card.astro";

type Pokemon = {
  name: string;
  url: string;
  official_artwork?: string;
  types?: string[];
};

const response = await fetch(POKEMON_URL);
const data = await response.json();

const pokemonList: Pokemon[] = await Promise.all(
  data.results.map(async (poke: Pokemon) => {
    try {
      const res = await fetch(poke.url);
      const details = await res.json();

      return {
        name: poke.name,
        url: poke.url,
        official_artwork:
          details.sprites.other["official-artwork"].front_default,
        types: details.types.map((t: any) => t.type.name),
      };
    } catch {
      return {
        name: poke.name,
        url: poke.url,
        types: ["normal"],
      };
    }
  })
);
---

<MainLayout title="Pokémon Index">
  <div class="lab">

    <header class="header">
      <h1>POKÉMON RESEARCH INDEX</h1>
      <p>Biological classification archive</p>
    </header>

    <ul class="pokemon-grid">
      {pokemonList.map((poke, index) => (
        <Card {...poke} id={index + 1} />
      ))}
    </ul>

  </div>
</MainLayout>

<style>
  .lab {
    min-height: 100vh;
    padding: 2rem;
    background: #f0f8ff;
  }

  .header {
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #000000;
  }

  .header h1 {
    font-size: 1.1rem;
    letter-spacing: 2px;
    margin: 0;
  }

  .header p {
    margin: 0.3rem 0 0;
    font-size: 0.85rem;
    color: #666;
  }
</style>