---
import { POKEMON_URL } from "./shared.js";
import MainLayout from "../layouts/MainLayout.astro";
import Card from "../components/Card.astro";

const response = await fetch(POKEMON_URL);
const data = await response.json();

const pokemonList = await Promise.all(
  (data.results as { name: string; url: string }[]).map(async (poke) => {
    try {
      const res = await fetch(poke.url);
      const details = await res.json();

      return {
        name: poke.name,
        url: poke.url,
        official_artwork:
          details?.sprites?.other?.["official-artwork"]?.front_default ?? null,
        types:
          details?.types?.map(
            (t: { type: { name: string } }) => t.type.name
          ) ?? ["normal"],
      };
    } catch {
      return {
        name: poke.name,
        url: poke.url,
        official_artwork: null,
        types: ["normal"],
      };
    }
  })
);
---

<MainLayout title="Pokémon Collection">
  <div class="page">

    <header class="header">
      <h1>POKÉMON CARD COLLECTION</h1>
    </header>

    <ul class="pokemon-grid">
      {pokemonList.map((poke, index) => (
        <Card {...poke} id={index + 1} />
      ))}
    </ul>

  </div>
</MainLayout>

<style>
.page {
  min-height: 100vh;
  padding: 2rem 3rem;
  background: #f0f8ff;
}

.header {
  position: relative;
  overflow: hidden;

  width: 80vw;
  margin: 0 auto 2.5rem;
  padding: 2.5rem 2rem;

  background: linear-gradient(135deg, #ffcb05 0%, #ff9f1c 100%);

  box-shadow: 0 12px 30px rgba(0,0,0,0.2);

  border: 3px solid #000000;
}

.header::before,
.header::after {
  content: "";
  position: absolute;
  border-radius: 50%;
  background: rgba(255,255,255,0.12);
}

.header::before {
  width: 180px;
  height: 180px;
  top: -50px;
  right: -50px;
}

.header::after {
  width: 120px;
  height: 120px;
  bottom: -40px;
  left: -40px;
}

.header h1 {
  margin: 0;

  font-size: 3.6em;
  font-weight: 900;
  letter-spacing: 3px;

  color: #2a75bb;

  text-shadow:
    2px 2px 0 #fff,
    4px 4px 0 rgba(0,0,0,0.12);
}

.pokemon-grid {
  list-style: none;
  padding: 0;

  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 1.2rem;

  max-width: 80vw;
  margin: 0 auto;
}
</style>