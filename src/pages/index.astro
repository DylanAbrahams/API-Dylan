---
import {POKEMON_URL} from "./shared.js"

import MainLayout from "../layouts/MainLayout.astro";
import Card from "../components/Card.astro";

type Pokemon = { 
  name: string; 
  url: string; 
  front_default?: string; 
  front_shiny?: string; 
  official_artwork?: string;
};

let pokemonList: Pokemon[] = [];

try {
  const response = await fetch(POKEMON_URL);
  const data = await response.json();

  if (data.results) {
    pokemonList = await Promise.all(
      data.results.map(async (poke: Pokemon) => {
        try {
          const res = await fetch(poke.url);
          const details = await res.json();

          return {
            ...poke,
            front_default: details.sprites.front_default,
            front_shiny: details.sprites.front_shiny,
            official_artwork:
              details.sprites.other["official-artwork"].front_default,
          };
        } catch {
          return poke;
        }
      })
    );
  }
} catch (error) {
  console.error("Fout bij ophalen Pokémon:", error);
}
---

<MainLayout title="Pokémon Lijst">
  {pokemonList.length > 0 ? (
    <ul style="display:grid; grid-template-columns:repeat(auto-fill, minmax(180px,1fr)); gap:1rem; list-style:none; padding:0;">
      {pokemonList.map((poke) => (
        <Card {...poke} />
      ))}
    </ul>
  ) : (
    <p style="text-align:center;">Geen Pokémon gevonden of fout bij ophalen.</p>
  )}
</MainLayout>