---
import { POKEMON_URL } from "./shared.js";
import MainLayout from "../layouts/MainLayout.astro";
import Card from "../components/Card.astro";

const response = await fetch(POKEMON_URL);
const data = await response.json();

const pokemonList = await Promise.all(
  (data.results as { name: string; url: string }[]).map(async (poke) => {
    try {
      const res = await fetch(poke.url);
      const details = await res.json();

      return {
        name: poke.name,
        url: poke.url,
        official_artwork:
          details?.sprites?.other?.["official-artwork"]?.front_default ?? null,
        types:
          details?.types?.map(
            (t: { type: { name: string } }) => t.type.name
          ) ?? ["normal"],
      };
    } catch {
      return {
        name: poke.name,
        url: poke.url,
        official_artwork: null,
        types: ["normal"],
      };
    }
  })
);
---

<MainLayout title="Pokémon Collection">
  <div class="page">

    <header class="header">
      <h1>POKÉMON COLLECTION</h1>
      <p>Select a card</p>
    </header>

    <ul class="pokemon-grid">
      {pokemonList.map((poke, index) => (
        <Card {...poke} id={index + 1} />
      ))}
    </ul>

  </div>
</MainLayout>

<style>
.page {
  min-height: 100vh;
  padding: 2rem 3rem;
  background: #f0f8ff;
}

.header {
  width:80vw;
  margin: 0 auto 2rem;
  padding: 1rem;
  background: linear-gradient(145deg, #ffe066, #f2c94c);
  border: 2px solid #000;
  box-shadow: 0 10px 25px rgba(0,0,0,0.25);
}

.pokemon-grid {
  list-style: none;
  padding: 0;

  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 1.2rem;

  max-width: 80vw;
  margin: 0 auto;
}
</style>