---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
const { title = "Pokémon Lijst" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="stylesheet" href="/styles/global.css" />
  </head>

  <body>
    <!-- Header -->
    <Header title={title} />

    <!-- Page content -->
    <main class="main">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />

    <script type="module">
      import { loadPokemon, removePokemon } from "../game/pokemonStorage.js";

      function renderFooter() {
        const el = document.querySelector("#my-pokemon-list");
        if (!el) return;

        const list = loadPokemon();

        el.innerHTML = "";

        list.forEach((p) => {
          const li = document.createElement("li");

          const img = document.createElement("img");
          img.src = p.frontSprite;

          const span = document.createElement("span");
          span.textContent = p.name;

          const btn = document.createElement("button");
          btn.textContent = "x";

          btn.onclick = () => {
            removePokemon(p.name);
            renderFooter();
          };

          li.append(img, span, btn);
          el.appendChild(li);
        });
      }

      // initial render
      document.addEventListener("DOMContentLoaded", renderFooter);

      //  live updates
      window.addEventListener("pokemon-updated", renderFooter);
    </script>
  </body>
</html>
