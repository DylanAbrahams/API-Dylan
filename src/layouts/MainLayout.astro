---
import Header from "../components/Header.astro";
import PokemonOverlay from "../components/PokemonOverlay.astro";
const { title = "Pokémon Lijst" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="stylesheet" href="/styles/global.css" />
  </head>

  <body>
    <!-- Header -->
    <Header title={title} />

    <!-- Page content -->
    <main class="main">
      <slot />
    </main>

    <!-- Pokemon Overlay -->
    <PokemonOverlay />

    <script type="module">
      import { loadPokemon, removePokemon } from "../game/pokemonStorage.js";

      function renderPokemonOverlay() {
        const el = document.querySelector("#my-pokemon-list");
        if (!el) return;

        const list = loadPokemon();
        el.innerHTML = "";

        list.forEach((p) => {
          const li = document.createElement("li");

          const img = document.createElement("img");
          img.src = p.frontSprite;
          img.alt = p.name;

          const btn = document.createElement("button");
          btn.textContent = "✕";

          btn.onclick = (e) => {
            e.stopPropagation();
            removePokemon(p.name);
            renderPokemonOverlay();
          };

          li.appendChild(img);
          li.appendChild(btn);

          el.appendChild(li);
        });
      }

      // init
      document.addEventListener("DOMContentLoaded", renderPokemonOverlay);

      // live updates
      window.addEventListener("pokemon-updated", renderPokemonOverlay);
    </script>
  </body>
</html>
